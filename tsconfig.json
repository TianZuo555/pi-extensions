{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["extensions/**/*.ts", "packages/**/*.ts"],
  "exclude": [
    "extensions/background-terminals.ts",
    "packages/pi-background-terminals/**/*.ts",
    "extensions/goal.ts",
    "packages/pi-goal/**/*.ts",
    "extensions/usage.ts",
    "packages/pi-usage/**/*.ts",
    "extensions/commit.ts",
    "packages/pi-commit/**/*.ts",
    "extensions/subagents.ts",
    "packages/pi-subagents/**/*.ts",
    "extensions/image-cache.ts",
    "packages/pi-image-cache/**/*.ts"
  ]
}

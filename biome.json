{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/**",
      "extensions/**",
      "scripts/**",
      "tests/**",
      "!packages/pi-edit-safe",
      "!packages/pi-goal",
      "!packages/pi-subagents",
      "!packages/pi-todo",
      "!packages/pi-vscode-bridge",
      "!packages/pi-antigravity/CHANGELOG.md",
      "!packages/pi-antigravity/PLAN.md",
      "!packages/pi-antigravity/README.md",
      "!packages/pi-ask-user/README.md",
      "!packages/pi-background-terminals/CHANGELOG.md",
      "!packages/pi-background-terminals/docs/implementation-guide.md",
      "!packages/pi-background-terminals/README.md",
      "!packages/pi-commit/README.md",
      "!packages/pi-compact/CHANGELOG.md",
      "!packages/pi-compact/docs/auth-and-cache.md",
      "!packages/pi-compact/README.md",
      "!packages/pi-devin-acp/CHANGELOG.md",
      "!packages/pi-devin-acp/PLAN.md",
      "!packages/pi-devin-acp/README.md",
      "!packages/pi-find/CHANGELOG.md",
      "!packages/pi-find/README.md",
      "!packages/pi-usage/README.md",
      "!packages/pi-web-search/CHANGELOG.md",
      "!packages/pi-web-search/README.md"
    ],
    "ignoreUnknown": false
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noControlCharactersInRegex": "off",
        "noConfusingVoidType": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts", "**/*.test.mjs"],
      "linter": {
        "rules": {
          "complexity": {
            "useLiteralKeys": "off"
          },
          "suspicious": {
            "noExplicitAny": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/pi-beautify-style/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ],
  "assist": {
    "enabled": false
  }
}

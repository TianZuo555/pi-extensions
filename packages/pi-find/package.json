{
  "name": "@tian.zuo/pi-find",
  "version": "0.2.1",
  "description": "ripgrep/fd-backed grep and find tools for the pi coding agent, with a path-constraint DSL, directory pruning, multi-pattern support, and whole-path matching.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "ripgrep",
    "fd",
    "grep",
    "find"
  ],
  "author": "Tian Zuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-extensions.git",
    "directory": "packages/pi-find"
  },
  "homepage": "https://github.com/TianZuo555/pi-extensions#pi-find",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-extensions/issues"
  },
  "files": [
    "index.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101",
    "minimatch": "^10.2.6"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-tian-extensions.git",
    "directory": "packages/pi-compact-output"
  },
  "homepage": "https://github.com/TianZuo555/pi-tian-extensions#pi-compact-output",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-tian-extensions/issues"
  },
  "files": [
    "index.ts",
    "lib",
    "README.md",
    "LICENSE"
  ],

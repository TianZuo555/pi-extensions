{
  "name": "pi-tian-search",
  "version": "0.1.1",
  "description": "ripgrep/fd-backed grep, find, and multi_grep tools for the pi coding agent, with a path-constraint DSL, exclude filters, fuzzy path matching, and cursor pagination.",
  "type": "module",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "ripgrep",
    "fd",
    "grep",
    "find",
    "fuzzy-search"
  ],
  "author": "Tian Zuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-tian-extensions.git",
    "directory": "packages/pi-search"
  },
  "homepage": "https://github.com/TianZuo555/pi-tian-extensions#pi-search",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-tian-extensions/issues"
  },
  "files": [
    "index.ts",
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101",
    "fzf": "^0.5.2",
    "minimatch": "^10.2.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

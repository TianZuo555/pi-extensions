{
  "name": "pi-tian-vscode-bridge",
  "version": "0.1.0",
  "description": "Send file, line, and diff-hunk references from VS Code into a running pi agent's input editor.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "vscode"
  ],
  "author": "Tian Zuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-tian-extensions.git",
    "directory": "packages/pi-vscode-bridge"
  },
  "homepage": "https://github.com/TianZuo555/pi-tian-extensions#pi-vscode-bridge",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-tian-extensions/issues"
  },
  "files": [
    "index.ts",
    "lib",
    "src",
    "vscode/package.json",
    "vscode/out"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "main": "./vscode/out/extension.js",
  "publisher": "tianzuo",
  "displayName": "Pi VS Code Bridge",
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "pi-vscode-bridge.sendFromExplorer",
        "title": "Send to Pi"
      },
      {
        "command": "pi-vscode-bridge.sendFromEditor",
        "title": "Send to Pi"
      },
      {
        "command": "pi-vscode-bridge.sendHunk",
        "title": "Send Hunk to Pi"
      },
      {
        "command": "pi-vscode-bridge.showStatus",
        "title": "Pi Bridge: Show Attached Agent"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "pi-vscode-bridge.sendFromExplorer",
          "group": "pi@1",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "pi-vscode-bridge.sendFromEditor",
          "group": "pi@1",
          "when": "editorTextFocus && !isInDiffEditor"
        },
        {
          "command": "pi-vscode-bridge.sendHunk",
          "group": "pi@1",
          "when": "editorTextFocus && isInDiffEditor"
        }
      ],
      "commandPalette": [
        {
          "command": "pi-vscode-bridge.sendFromExplorer",
          "when": "false"
        },
        {
          "command": "pi-vscode-bridge.sendHunk",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "compile:vscode": "tsc -p vscode/tsconfig.json",
    "watch:vscode": "tsc -watch -p vscode/tsconfig.json",
    "prepack": "pnpm run compile:vscode",
    "package:vscode": "pnpm dlx @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "pnpm run compile:vscode"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

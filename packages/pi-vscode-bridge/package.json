{
  "name": "@tian.zuo/pi-vscode-bridge",
  "version": "0.1.0",
  "description": "Send file, line, and diff-hunk references from VS Code into a running pi agent's input editor.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "vscode"
  ],
  "author": "Tian Zuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-extensions.git",
    "directory": "packages/pi-vscode-bridge"
  },
  "homepage": "https://github.com/TianZuo555/pi-extensions#pi-vscode-bridge",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-extensions/issues"
  },
  "files": [
    "index.ts",
    "lib",
    "src",
    "vscode/package.json",
    "vscode/out"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "compile:vscode": "tsc -p vscode/tsconfig.json",
    "watch:vscode": "tsc -watch -p vscode/tsconfig.json",
    "prepack": "pnpm run compile:vscode",
    "package:vscode": "pnpm run compile:vscode && cd vscode && pnpm dlx @vscode/vsce package --no-dependencies"
  },
  "dependencies": {
    "effect": "4.0.0-beta.101"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.125.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}

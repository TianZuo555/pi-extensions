{
  "name": "pi-extensions",
  "version": "0.1.0",
  "description": "A collection of extensions for the pi coding agent: per-repository defaults, skill toggles, commits, token speed, and more.",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent"
  ],
  "author": "Tian Zuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-extensions.git"
  },
  "homepage": "https://github.com/TianZuo555/pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-extensions/issues"
  },
  "pi": {
    "extensions": [
      "extensions/pi-repo-model.ts",
      "extensions/pi-repo-skills.ts",
      "extensions/commit.ts",
      "extensions/image-cache.ts",
      "extensions/token-speed.ts",
      "extensions/ask-user.ts",
      "extensions/usage.ts",
      "extensions/edit-safe.ts",
      "extensions/background-terminals.ts",
      "extensions/subagents.ts",
      "extensions/compact-output.ts",
      "extensions/goal.ts",
      "extensions/todo.ts",
      "extensions/vscode-bridge.ts",
      "extensions/web-search.ts",
      "extensions/find.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "pnpm -r run check",
    "test": "pnpm run test:usage && pnpm -r test",
    "test:usage": "node --test tests/pi-usage-providers.test.mjs",
    "test:ask-user": "pnpm --filter @tian.zuo/pi-ask-user test",
    "test:commit": "pnpm --filter @tian.zuo/pi-commit test",
    "test:edit-safe": "pnpm --filter @tian.zuo/pi-edit-safe test",
    "test:repo-model": "pnpm --filter @tian.zuo/pi-repo-model test",
    "test:repo-skills": "pnpm --filter @tian.zuo/pi-repo-skills test",
    "test:todo": "pnpm --filter @tian.zuo/pi-todo test",
    "test:token-speed": "pnpm --filter @tian.zuo/pi-token-speed test",
    "test:subagents": "pnpm --filter @tian.zuo/pi-subagents test",
    "test:compact-output": "pnpm --filter @tian.zuo/pi-compact-output test",
    "test:goal": "pnpm --filter @tian.zuo/pi-goal test",
    "test:image-cache": "pnpm --filter @tian.zuo/pi-image-cache test",
    "test:background-terminals": "pnpm --filter @tian.zuo/pi-background-terminals test",
    "test:vscode-bridge": "pnpm --filter @tian.zuo/pi-vscode-bridge test",
    "test:web-search": "pnpm --filter @tian.zuo/pi-web-search test",
    "test:find": "pnpm --filter @tian.zuo/pi-find test",
    "pack:check": "pnpm -r pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^26.2.0",
    "typebox": "^1.3.15",
    "typescript": "^7.0.2"
  }
}

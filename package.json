{
  "name": "pi-tian-extensions",
  "version": "0.1.0",
  "description": "A collection of extensions for the pi coding agent: per-repository defaults, skill toggles, commits, token speed, and more.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "coding-agent"
  ],
  "author": "Tian Zuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TianZuo555/pi-tian-extensions.git"
  },
  "homepage": "https://github.com/TianZuo555/pi-tian-extensions#readme",
  "bugs": {
    "url": "https://github.com/TianZuo555/pi-tian-extensions/issues"
  },
  "pi": {
    "extensions": [
      "extensions/pi-repo-model.ts",
      "extensions/pi-repo-skills.ts",
      "extensions/commit.ts",
      "extensions/image-cache.ts",
      "extensions/token-speed.ts",
      "extensions/ask-user.ts",
      "extensions/usage.ts",
      "extensions/edit-safe.ts",
      "extensions/background-terminals.ts",
      "extensions/subagents.ts",
      "extensions/compact-output.ts",
      "extensions/goal.ts",
      "extensions/todo.ts",
      "extensions/vscode-bridge.ts",
      "extensions/web-search.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test:usage && npm test --workspaces --if-present",
    "test:usage": "node --test tests/pi-usage-providers.test.mjs",
    "test:ask-user": "npm test -w pi-tian-ask-user",
    "test:commit": "npm test -w pi-tian-commit",
    "test:edit-safe": "npm test -w pi-tian-edit-safe",
    "test:repo-model": "npm test -w pi-tian-repo-model",
    "test:repo-skills": "npm test -w pi-tian-repo-skills",
    "test:todo": "npm test -w pi-tian-todo",
    "test:token-speed": "npm test -w pi-tian-token-speed",
    "test:subagents": "npm test -w pi-tian-subagents",
    "test:compact-output": "npm test -w pi-tian-compact-output",
    "test:goal": "npm test -w pi-tian-goal",
    "test:image-cache": "npm test -w pi-tian-image-cache",
    "test:background-terminals": "npm test -w pi-tian-background-terminals",
    "test:vscode-bridge": "npm test -w pi-tian-vscode-bridge",
    "test:web-search": "npm test -w pi-tian-web-search",
    "pack:check": "npm pack --dry-run --workspaces"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
